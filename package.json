{
  "name": "@emmaneugene/pi-cursor-sdk",
  "version": "0.5.2",
  "description": "pi provider extension backed by @cursor/sdk local agents",
  "publishConfig": {
    "access": "public"
  },
  "author": "Emmanuel Oh <emmaneugene@outlook.com> (https://github.com/emmaneugene)",
  "contributors": [
    "Mitch Fultz (https://github.com/fitchmultz)"
  ],
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "cursor",
    "cursor-sdk",
    "ai",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmaneugene/pi-cursor-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/emmaneugene/pi-cursor-sdk/issues"
  },
  "homepage": "https://github.com/emmaneugene/pi-cursor-sdk#readme",
  "files": [
    "dist",
    "shared",
    "src",
    "scripts",
    "tsconfig.build.json",
    "tsconfig.json",
    "README.md",
    "docs/model-ux-spec.md",
    "docs/tool-surfaces.md",
    "docs/live-smoke-checklist.md",
    "docs/testing-lessons.md",
    "docs/dogfood-checklist.md",
    "docs/native-tool-replay.md",
    "docs/native-tool-visual-audit.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests && npm run typecheck:replay-compile",
    "typecheck:src": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:replay-compile": "tsc --noEmit -p test/tsconfig.json",
    "verify": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "refresh:cursor-snapshots": "node scripts/refresh-model-snapshots.mjs",
    "check:cursor-snapshots": "node scripts/refresh-model-snapshots.mjs --check",
    "smoke:live": "npm run build && scripts/tmux-live-smoke.sh",
    "smoke:visual": "npm run build && node scripts/visual-tui-smoke.mjs",
    "smoke:isolated": "npm run build && scripts/isolated-smoke.sh",
    "smoke:steering": "node scripts/steering-rpc-smoke.mjs",
    "smoke:jsonl": "node scripts/validate-smoke-jsonl.mjs",
    "debug:sdk-events": "node scripts/debug-sdk-events.mjs",
    "debug:provider-events": "node scripts/debug-provider-events.mjs",
    "debug:mcp-coldstart": "node scripts/probe-mcp-coldstart.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.30",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "bundledDependencies": [
    "@hono/node-server",
    "@modelcontextprotocol/sdk"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@xterm/xterm": "^6.0.0",
    "playwright": "^1.60.0",
    "typebox": "1.3.27",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@hono/node-server",
    "@modelcontextprotocol/sdk"
  ]
}
